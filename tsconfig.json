{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": { "@/*": ["apps/showcase/src/*"] },
    "types": ["node"]
  },
  "include": ["registry", "apps/showcase/src", "apps/showcase/vite.config.ts", "tests", "playwright.config.ts"]
}
