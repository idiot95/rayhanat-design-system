{
  "name": "al-rayhaanat",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "al-Rayhaanat v2: stock shadcn/ui, one brand theme, ten brand components, and the checks that hold them in place.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config apps/showcase/vite.config.ts",
    "build": "vite build --config apps/showcase/vite.config.ts",
    "preview": "vite preview --config apps/showcase/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "registry:build": "shadcn build registry.json --output public/r",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs registry/theme/theme.css",
    "check:drift": "node scripts/check-drift.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm check:contrast && pnpm check:drift && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.511.0",
    "radix-ui": "1.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.29.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "shadcn": "3.8.5",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vite": "6.3.5"
  }
}
