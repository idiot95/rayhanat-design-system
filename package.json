{
  "name": "al-rayhaanat",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "al-Rayhaanat Design System — tokens, components and the documentation site.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @al-rayhaanat/docs dev",
    "build:tokens": "style-dictionary build --config tokens/style-dictionary.config.mjs",
    "build:bundle": "node scripts/bundle-global.mjs",
    "build": "pnpm --filter @al-rayhaanat/docs build",
    "build:docs": "pnpm --filter @al-rayhaanat/docs build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:all": "pnpm build:tokens && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "style-dictionary": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
