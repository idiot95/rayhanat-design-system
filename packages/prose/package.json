{
  "name": "@al-rayhaanat/prose",
  "version": "1.3.0",
  "description": "Rich text — every block a content field may emit.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.jsx",
      "default": "./src/index.jsx"
    }
  },
  "dependencies": {
    "@al-rayhaanat/tokens": "workspace:*",
    "@al-rayhaanat/icons": "workspace:*",
    "@al-rayhaanat/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "src",
    "dist"
  ],
  "arh": {
    "distribution": "source-jsx",
    "requiresTranspile": true
  }
}
